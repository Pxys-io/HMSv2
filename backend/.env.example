# HMSv2 backend environment (development defaults).
# Copy to `.env` and adjust. NEVER commit the real `.env`.

APP_ENV=dev

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-prod
TOKEN_ALG=HS256
# Required for encrypted national-ID fields (32-byte urlsafe base64). Generate
# with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEY=

# ---- Databases ----
DATABASE_URL=sqlite:///./hmsv2.db
AUDIT_DATABASE_URL=sqlite:///./hmsv2_audit.db

# ---- Clinic ----
CLINIC_TZ=Africa/Cairo
CURRENCY=EGP

# ---- Files ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
CLAMAV_SOCKET=

# ---- CORS (exact origins only) ----
CORS_STAFF_ORIGINS=["http://localhost:5173"]
CORS_PUBLIC_ORIGINS=["http://localhost:5174"]

# ---- Cookies / auth ----
ACCESS_COOKIE_NAME=hmsv2_access
REFRESH_COOKIE_NAME=hmsv2_refresh
CSRF_COOKIE_NAME=hmsv2_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_MINUTES_STAFF=30
REFRESH_TOKEN_DAYS_STAFF=30
ACCESS_TOKEN_MINUTES_PATIENT=30
REFRESH_TOKEN_DAYS_PATIENT=60

# ---- Idempotency ----
IDEMPOTENCY_TTL_DAYS=7

# ---- Audit checkpoints ----
AUDIT_CHECKPOINT_PRIVATE_KEY_PATH=
AUDIT_CHECKPOINT_DIR=./checkpoints

# ---- SMTP (empty host = email disabled, rendered to logs) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Public API ----
RATE_LIMIT_PUBLIC=60/minute
